{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cdsap/BuildExperimentResults/schema/experiment-result.v1.json",
  "title": "Experiment Result",
  "description": "Canonical BER experiment result. schemaVersion 1.x is additive; unknown major versions must be rejected.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "generatedAt",
    "producer",
    "report",
    "experiment",
    "execution",
    "variants",
    "metrics",
    "datasets",
    "diagnostics",
    "warnings",
    "completeness"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["complete", "partial", "failed"] }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "repository": { "type": ["string", "null"] },
        "requestedTasks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mode": { "type": ["string", "null"] },
        "isProfiler": { "type": "boolean" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "runId": { "type": ["string", "null"] },
        "runAttempt": { "type": ["integer", "null"], "minimum": 1 },
        "workflowName": { "type": ["string", "null"] },
        "startedAt": { "type": ["string", "null"] },
        "links": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "label", "sourceTag", "role", "buildCount"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "label": { "type": "string" },
          "sourceTag": { "type": "string" },
          "role": { "type": "string" },
          "buildCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": { "$ref": "#/definitions/metric" }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": true,
      "required": ["builds", "taskSeries", "resourceSeries", "processSeries", "gcSeries"],
      "properties": {
        "builds": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/buildObservation" }
          }
        },
        "taskSeries": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/taskSeries" }
        },
        "resourceSeries": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/namedSeries" }
        },
        "processSeries": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/namedSeries" }
        },
        "gcSeries": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/namedSeries" }
        },
        "kotlinBuildReportSeries": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/namedSeries" }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not-requested", "unavailable", "partial", "present"]
        },
        "source": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "tool": { "type": "string" },
            "schemaVersion": { "type": ["string", "null"] },
            "experimentRunId": { "type": ["string", "null"] },
            "sourceRepo": { "type": ["string", "null"] }
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "family", "sampleUnit", "metricIds"],
            "properties": {
              "id": { "type": "string" },
              "family": { "type": "string" },
              "sampleUnit": { "type": "string" },
              "metricIds": {
                "type": "array",
                "items": { "type": "string" }
              },
              "jobKeysByVariant": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/definitions/warning" }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": true,
      "required": ["requestedVariantIds", "observedVariantIds", "missingMetricIds", "diagnostics"],
      "properties": {
        "requestedVariantIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observedVariantIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "missingMetricIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "diagnostics": {
          "type": "string",
          "enum": ["not-requested", "unavailable", "partial", "present"]
        }
      }
    }
  },
  "definitions": {
    "statistic": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mean", "p50", "p90"],
      "properties": {
        "mean": { "type": ["number", "null"] },
        "p50": { "type": ["number", "null"] },
        "p90": { "type": ["number", "null"] },
        "count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "family", "category", "name", "unit", "valueType", "aggregation", "values"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "family": { "type": "string" },
        "category": { "type": "string" },
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "valueType": { "type": "string" },
        "direction": { "type": ["string", "null"] },
        "scope": { "type": ["object", "null"] },
        "aggregation": {
          "type": "object",
          "additionalProperties": true,
          "required": ["sampleUnit", "method"],
          "properties": {
            "sampleUnit": { "type": "string" },
            "method": { "type": "string" }
          }
        },
        "values": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/statistic" }
        }
      }
    },
    "numericObservation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["observationId", "sequence", "value"],
      "properties": {
        "observationId": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "value": { "type": ["number", "null"] }
      }
    },
    "buildObservation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["observationId", "sequence", "durationMs", "configurationMs"],
      "properties": {
        "observationId": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "number" },
        "configurationMs": { "type": "number" },
        "startedAt": { "type": ["string", "null"] },
        "scanUrl": { "type": ["string", "null"] }
      }
    },
    "taskObservation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["observationId", "sequence", "durationMs"],
      "properties": {
        "observationId": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "number" },
        "outcome": { "type": ["string", "null"] }
      }
    },
    "taskSeries": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "observations"],
      "properties": {
        "path": { "type": "string" },
        "taskType": { "type": ["string", "null"] },
        "observations": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/taskObservation" }
          }
        }
      }
    },
    "namedSeries": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "unit", "observations"],
      "properties": {
        "name": { "type": "string" },
        "unit": { "type": "string" },
        "observations": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/numericObservation" }
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "severity", "source", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "source": { "type": "string" },
        "message": { "type": "string" },
        "variantId": { "type": ["string", "null"] },
        "metricId": { "type": ["string", "null"] }
      }
    }
  }
}
